# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Virtual environments
.env
.env.*
.venv*/
env/
venv/
ENV/
myenv/
.python-version

# Test and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ipynb_checkpoints

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Local assistant notes (each machine keeps its own)
CLAUDE.md

# ── Test pages ────────────────────────────────────────────────────────────
# Only the pages with known-good text in tests/golden/ are tracked. Pages you
# drop in to try something stay local; add one for good with `git add -f`
# together with its golden text.
test_images/*

# Output of scripts/reconstruct_eval.py and other local runs
reconstruct_out/
eval_out*/
/output/
/results/
/uploads/

# ── Models and data ───────────────────────────────────────────────────────
# The app downloads its models from Hugging Face (netra_ocr/models.py);
# checkpoints and datasets are training-only and never committed.
/models/
/bundles/
.hf_cache/
/test_set/
/research/
unsloth_compiled_cache/

# Training runs (training/*.sh): checkpoints, logs, exported folders. The YOLO
# line detector's training run in training/weights/yolo26s_best/ is tracked.
training/runs/
training/weights/*
!training/weights/yolo26s_best/
training/netra_ocr_train/EVAL_RESULTS.md
training/netra_ocr_train/TEST_SET_EVAL_RESULTS.md

# ── Web ───────────────────────────────────────────────────────────────────
node_modules/
