include readme.md
include LICENSE
include requirements.txt

# No model weights: the models are ONNX model folders downloaded on first
# use (see netra_ocr/models.py).
recursive-include netra_ocr/server/static *.html *.css *.svg *.js *.woff2

# Never ship build artifacts or the other (large) checkpoints
global-exclude *.pyc
prune **/__pycache__
